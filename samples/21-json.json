{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "vsc-adwaita-next",
  "displayName": "VSC Adwaita Next",
  "version": "1.0.0",
  "publisher": "vsc-adwaita-next",
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Themes", "Visualization"],
  "keywords": ["adwaita", "libadwaita", "gnome", "gtk", "gtk4"],
  "contributes": {
    "themes": [
      {
        "label": "Adwaita Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/dark.json"
      },
      {
        "label": "Adwaita Light",
        "uiTheme": "vs",
        "path": "./themes/light.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "adwaita",
        "label": "Adwaita",
        "path": "./icons/adwaita.json"
      }
    ]
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "validate": "bun scripts/validate.ts",
    "test": "bun test tests/",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run validate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.3.4",
    "@types/node": "24.10.1",
    "@vscode/vsce": "4.1.0",
    "typescript": "5.9.3"
  },
  "numbers": {
    "integer": 42,
    "negative": -7,
    "float": 1.5,
    "exponent": 1.5e-9,
    "hex": 4294940544,
    "big": 9007199254740993
  },
  "booleans": [true, false, null],
  "escaped": "tab\tnewline\nquote\"backslash\\unicode\u00e9"
}
